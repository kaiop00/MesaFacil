# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Stripe Configuration (Frontend - Publishable Key)
# Get this from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Product Price IDs (replace with your actual Stripe Price IDs)
# Get these from: https://dashboard.stripe.com/test/products
VITE_STRIPE_MONTHLY_PRICE_ID=price_monthly
VITE_STRIPE_BIMONTHLY_PRICE_ID=price_bimonthly
VITE_STRIPE_QUARTERLY_PRICE_ID=price_quarterly
VITE_STRIPE_SEMIANNUAL_PRICE_ID=price_semiannual

# Your Firebase Functions URL for Stripe API endpoints
# For development (emulator): http://127.0.0.1:5001/your_project_id/us-central1
# For production: https://us-central1-your_project_id.cloudfunctions.net
VITE_API_BASE_URL=http://127.0.0.1:5001/your_project_id/us-central1

# Firebase Functions URL (same as API_BASE_URL but used by integrations)
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-your_project_id.cloudfunctions.net

# Application URL (used for OAuth redirects)
VITE_APP_URL=http://localhost:5173

# ─── Nuvem Fiscal (NFC-e) ───────────────────────────────
# Used by Firebase Functions only (not VITE_ prefixed)
# Set these in functions/.env.local for local dev
# or via Firebase secrets for production:
#   firebase functions:secrets:set NUVEM_FISCAL_CLIENT_ID
#   firebase functions:secrets:set NUVEM_FISCAL_CLIENT_SECRET
# NUVEM_FISCAL_CLIENT_ID=your_nuvem_fiscal_client_id
# NUVEM_FISCAL_CLIENT_SECRET=your_nuvem_fiscal_client_secret
