# Stripe Secret Key for Firebase Functions (Backend)
# Get this from: https://dashboard.stripe.com/test/apikeys
# This key should start with 'sk_test_' for test mode
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# iFood Integration (Distributed App Model)
# Get these from iFood Developer Portal: https://developer.ifood.com.br
# These are used by the Cloud Functions for OAuth and polling
IFOOD_CLIENT_ID=your_ifood_client_id
IFOOD_CLIENT_SECRET=your_ifood_client_secret
FUNCTION_URL=https://us-central1-projectmesafacil.cloudfunctions.net
# Application URL (for OAuth success redirects)
# This is used by the OAuth callback to redirect users back to your app
APP_URL=https://your-domain.com

# Note: FIREBASE_FUNCTIONS_URL is automatically available in Cloud Functions
# as process.env.FUNCTION_TARGET or can be constructed from GCLOUD_PROJECT
