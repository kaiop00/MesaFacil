rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSameRestaurant(restId) {
      return isAuthenticated() && userDoc().idRestaurante == restId;
    }

    // Usuários podem ler/escrever seu próprio documento
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Coleções públicas/compartilhadas - usuários autenticados podem ler
    match /categorias/{catId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /configuracoesGerais/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Dados do restaurante - leitura permissiva para autenticados
    match /restaurantes/{restId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Regras para o módulo de Caixa
    match /restaurantes/{restId}/caixaSessions/{sessionId} {
      // Somente usuários autenticados do mesmo restaurante podem ler
      allow read: if isSameRestaurant(restId);

      // Criar apenas se o usuário pertence ao restaurante e campos essenciais corretos
      allow create: if isSameRestaurant(restId)
        && request.resource.data.empresaId == restId
        && request.resource.data.usuarioAberturaId == request.auth.uid
        && request.resource.data.status == 'ABERTO'
        && request.resource.data.dataAbertura is string;

      // Atualizar: somente se a sessão está ABERTO
      allow update: if isSameRestaurant(restId)
        && resource.data.status == 'ABERTO'
        && (
          (request.resource.data.status == resource.data.status && request.resource.data.usuarioAberturaId == resource.data.usuarioAberturaId)
          ||
          (request.resource.data.status == 'FECHADO' && request.resource.data.usuarioFechamentoId == request.auth.uid)
        );

      allow delete: if false;
    }

    match /restaurantes/{restId}/caixaPagamentos/{docId} {
      allow read: if isSameRestaurant(restId);
      allow create: if isSameRestaurant(restId)
        && request.resource.data.empresaId == restId
        && request.resource.data.caixaSessionId is string
        && request.resource.data.pedidoId is string
        && request.resource.data.valor is number;
      allow update, delete: if false;
    }

    match /restaurantes/{restId}/caixaLancamentos/{docId} {
      allow read: if isSameRestaurant(restId);
      allow create: if isSameRestaurant(restId)
        && request.resource.data.empresaId == restId
        && request.resource.data.caixaSessionId is string
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.valor is number;
      allow update, delete: if false;
    }

    match /restaurantes/{restId}/caixaMovimentacoes/{docId} {
      allow read: if isSameRestaurant(restId);
      allow create: if isSameRestaurant(restId)
        && request.resource.data.empresaId == restId
        && request.resource.data.caixaSessionId is string
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.valor is number
        && request.resource.data.tipo in ['SUPRIMENTO','SANGRIA','ENTRADA_EXTRA'];
      allow update, delete: if false;
    }

    // Subcoleções do restaurante - leitura permissiva para autenticados durante inicialização
    match /restaurantes/{restId}/cardapio/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSameRestaurant(restId);
    }

    match /restaurantes/{restId}/mesas/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSameRestaurant(restId);
    }

    match /restaurantes/{restId}/pedidos/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSameRestaurant(restId);
    }

    match /restaurantes/{restId}/itemsCardapio/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSameRestaurant(restId);
    }

    match /restaurantes/{restId}/promocoes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSameRestaurant(restId);
    }

    match /restaurantes/{restId}/usuarios/{docId} {
      allow read: if isSameRestaurant(restId);
      allow write: if isSameRestaurant(restId);
    }

    match /restaurantes/{restId}/movimentacoes/{docId} {
      allow read: if isSameRestaurant(restId);
      allow write: if isSameRestaurant(restId);
    }

    // Fallback: outras subcoleções do restaurante
    match /restaurantes/{restId}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}